<aside class="sidebar">
  <a class="sidebar-brand" href="/">
    <span class="sidebar-brand-mark">&#9670;</span>
    <span class="sidebar-brand-text">The Compendium</span>
  </a>

  <form class="sidebar-search" action="/search" method="get">
    <input type="text" name="q" placeholder="Search..." value="<%= typeof q !== 'undefined' ? q : '' %>" />
  </form>

  <a class="sidebar-new" href="/entries/new">+ New Entry</a>

  <nav class="sidebar-nav">
    <a class="sidebar-nav-item <%= currentPath === '/' ? 'active' : '' %>" href="/">
      All Regions
    </a>
    <% sidebarCategories.forEach(function(category) { %>
      <a class="sidebar-nav-item <%= currentPath === '/categories/' + category.slug ? 'active' : '' %>"
         href="/categories/<%= category.slug %>">
        <span class="sidebar-nav-name"><%= category.name %></span>
        <span class="sidebar-nav-count"><%= category.entry_count %></span>
      </a>
    <% }); %>
  </nav>

  <form class="sidebar-footer" action="/logout" method="post">
    <button type="submit" class="logout-btn">Log out</button>
  </form>
</aside>
