<h1><%= category.name %></h1>
<p><%= category.description %></p>

<a class="new-entry-link" href="/entries/new">+ New Entry</a>

<div class="entry-card-list">
  <% entries.forEach(function(entry) { %>
    <%- include('../partials/entry-card', { entry: { ...entry, category_name: null } }) %>
  <% }); %>
</div>
