<h1>Search: "<%= q %>"</h1>

<% if (!q) { %>
  <p>Type something in the search bar to hunt the Compendium.</p>
<% } else if (results.length === 0) { %>
  <p>No entries found for "<%= q %>".</p>
<% } else { %>
  <div class="entry-card-list">
    <% results.forEach(function(entry) { %>
      <%- include('../partials/entry-card', { entry }) %>
    <% }); %>
  </div>
<% } %>
